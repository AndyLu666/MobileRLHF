{
  "format": "fedrl_preference_dataset_manifest.v1",
  "primary_dataset": "fedrl_health",
  "fallback_dataset": "fedrl_hf_fitness",
  "datasets": [
    {
      "id": "fedrl_health",
      "display_name": "Curated health preference dataset",
      "formal": true,
      "dpo": {
        "schema": "jsonl: prompt/chosen/rejected",
        "train": "android-visualizer/app/src/main/assets/mft_demo_data/fedrl_health_dpo_train.jsonl",
        "eval": "android-visualizer/app/src/main/assets/mft_demo_data/fedrl_health_dpo_eval.jsonl",
        "train_rows": 24,
        "eval_rows": 6,
        "sample_keys": [
          "chosen",
          "domain",
          "prompt",
          "quality_tags",
          "rejected",
          "source"
        ]
      },
      "kto": {
        "schema": "jsonl: prompt/response/label",
        "train": "android-visualizer/app/src/main/assets/mft_demo_data/fedrl_health_kto_train.jsonl",
        "eval": "android-visualizer/app/src/main/assets/mft_demo_data/fedrl_health_kto_eval.jsonl",
        "train_rows": 48,
        "eval_rows": 12,
        "android_runtime_note": "Reference asset for validation and Python smoke runs. The Android runtime accepts binary KTO rows directly and explicitly unpairs DPO rows before canonical KTO batching.",
        "train_conversion": {
          "pairs": 24,
          "written": 48,
          "desirable": 24,
          "undesirable": 24,
          "skipped_invalid_json": 0,
          "skipped_missing_fields": 0,
          "skipped_identical": 0
        },
        "eval_conversion": {
          "pairs": 6,
          "written": 12,
          "desirable": 6,
          "undesirable": 6,
          "skipped_invalid_json": 0,
          "skipped_missing_fields": 0,
          "skipped_identical": 0
        },
        "sample_keys": [
          "feedback_format",
          "label",
          "prompt",
          "response",
          "source"
        ]
      },
      "android_assets": [
        "android-visualizer/app/src/main/assets/mft_demo_data/fedrl_health_dpo_train.jsonl",
        "android-visualizer/app/src/main/assets/mft_demo_data/fedrl_health_dpo_eval.jsonl",
        "android-visualizer/app/src/main/assets/mft_demo_data/fedrl_health_kto_train.jsonl",
        "android-visualizer/app/src/main/assets/mft_demo_data/fedrl_health_kto_eval.jsonl"
      ]
    },
    {
      "id": "fedrl_hf_fitness",
      "display_name": "HF fitness preference fallback dataset",
      "formal": false,
      "dpo": {
        "schema": "jsonl: prompt/chosen/rejected",
        "train": "android-visualizer/app/src/main/assets/mft_demo_data/fedrl_hf_fitness_dpo_train.jsonl",
        "eval": "android-visualizer/app/src/main/assets/mft_demo_data/fedrl_hf_fitness_dpo_eval.jsonl",
        "train_rows": 42,
        "eval_rows": 12,
        "sample_keys": [
          "chosen",
          "metadata",
          "prompt",
          "rejected",
          "row_index",
          "source",
          "split"
        ]
      },
      "kto": {
        "schema": "jsonl: prompt/response/label",
        "train": "android-visualizer/app/src/main/assets/mft_demo_data/fedrl_hf_fitness_kto_train.jsonl",
        "eval": "android-visualizer/app/src/main/assets/mft_demo_data/fedrl_hf_fitness_kto_eval.jsonl",
        "train_rows": 84,
        "eval_rows": 24,
        "android_runtime_note": "Reference asset for validation and Python smoke runs. The Android runtime accepts binary KTO rows directly and explicitly unpairs DPO rows before canonical KTO batching.",
        "train_conversion": {
          "pairs": 42,
          "written": 84,
          "desirable": 42,
          "undesirable": 42,
          "skipped_invalid_json": 0,
          "skipped_missing_fields": 0,
          "skipped_identical": 0
        },
        "eval_conversion": {
          "pairs": 12,
          "written": 24,
          "desirable": 12,
          "undesirable": 12,
          "skipped_invalid_json": 0,
          "skipped_missing_fields": 0,
          "skipped_identical": 0
        },
        "sample_keys": [
          "feedback_format",
          "label",
          "prompt",
          "response",
          "source"
        ]
      },
      "android_assets": [
        "android-visualizer/app/src/main/assets/mft_demo_data/fedrl_hf_fitness_dpo_train.jsonl",
        "android-visualizer/app/src/main/assets/mft_demo_data/fedrl_hf_fitness_dpo_eval.jsonl",
        "android-visualizer/app/src/main/assets/mft_demo_data/fedrl_hf_fitness_kto_train.jsonl",
        "android-visualizer/app/src/main/assets/mft_demo_data/fedrl_hf_fitness_kto_eval.jsonl"
      ]
    }
  ],
  "phone_feedback_dataset": {
    "id": "phone_qwen_feedback",
    "schema": "mixed jsonl: prompt/chosen/rejected or prompt/response/label",
    "path_on_phone": "files/mft_demo_data/inference_feedback.jsonl",
    "note": "Generated by the Android app after local A/B or thumbs feedback; raw rows stay on device."
  }
}
